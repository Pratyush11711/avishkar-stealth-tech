# Netlify reads this file (Cloudflare Pages too). Pages always fresh. Scripts and styles are kept for a year: every link to them
# carries ?v=<content hash> (tools/stamp.mjs), so a changed file is a new address and is fetched at once. Images 30 days.
# Cross-Origin-Resource-Policy stops other websites from embedding (hotlinking) our scripts, styles, images and 3D data.
# Content-Security-Policy: only our own files plus the booking calendar (cal.id), the lead email service (formsubmit.co)
# and, if switched on, Microsoft Clarity may run on the site.
# The OG image (assets/og/) stays open so Facebook, LinkedIn, X and WhatsApp can show the link preview.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://cal.id")
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cal.id https://*.cal.id https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://cal.id https://*.cal.id; img-src 'self' data: blob: https:; font-src 'self' data: https://cal.id https://*.cal.id; connect-src 'self' https:; frame-src 'self' https://cal.id https://*.cal.id; worker-src 'self'; manifest-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'self'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin-allow-popups
/sw.js
  Cache-Control: no-cache
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin
/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
  Cross-Origin-Resource-Policy: same-origin
/assets/logos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
  Cross-Origin-Resource-Policy: same-origin
/assets/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/assets/og/*
  Cache-Control: public, max-age=604800
