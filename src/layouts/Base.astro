<!-- runs before the first paint: theme (light by default), page loader hand-off, performance mode, splash -->
{isLanding ? (
  <script is:inline>
  (function(){var d=document.documentElement,c=d.classList,n=navigator,ls,ss;try{ls=localStorage;ss=sessionStorage}catch(e){}c.add('js');
  try{var t=ls.getItem('st-theme-v2');if(t==='light'||t==='dark')d.setAttribute('data-theme',t)}catch(e){}
  try{var pl=+ss.getItem('st-pl')||0;ss.removeItem('st-pl');if(pl&&Date.now()-pl<5000){c.add('pl-in');window.__plAt=pl;d.style.setProperty('--pl-t',(pl-Date.now())+'ms')}}catch(e){}
  try{var o=ls.getItem('st-perf'),m=/[?&]perf=(lite|full|auto)/.exec(location.search);if(m){o=m[1];ls.setItem('st-perf',o);if(o==='auto')ls.removeItem('st-lite')}
  if(o==='lite'||(o!=='full'&&((n.deviceMemory&&n.deviceMemory<=2)||(n.hardwareConcurrency&&n.hardwareConcurrency<=2)||(n.connection&&n.connection.saveData)||Date.now()-(+ls.getItem('st-lite')||0)<6048e5)))c.add('lite')}catch(e){}
  var rm=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches,cn=n.connection,seen=0;try{seen=ss.getItem('st-sp');ss.setItem('st-sp','1')}catch(e){}
  /* the intro plays once per visit (not on every reload) and never on 2G / data-saver connections */
  c.add(rm||seen||(cn&&(cn.saveData||/2g/.test(cn.effectiveType||'')))||c.contains('pl-in')?'no-sp':'sp-on');
  })();
  </script>
) : (
  <script is:inline>
  (function(){var d=document.documentElement,c=d.classList,n=navigator,ls,ss;try{ls=localStorage;ss=sessionStorage}catch(e){}c.add('js');
  try{var t=ls.getItem('st-theme-v2');if(t==='light'||t==='dark')d.setAttribute('data-theme',t)}catch(e){}
  try{var pl=+ss.getItem('st-pl')||0;ss.removeItem('st-pl');if(pl&&Date.now()-pl<5000){c.add('pl-in');window.__plAt=pl;d.style.setProperty('--pl-t',(pl-Date.now())+'ms')}}catch(e){}
  try{var o=ls.getItem('st-perf'),m=/[?&]perf=(lite|full|auto)/.exec(location.search);if(m){o=m[1];ls.setItem('st-perf',o);if(o==='auto')ls.removeItem('st-lite')}
  if(o==='lite'||(o!=='full'&&((n.deviceMemory&&n.deviceMemory<=2)||(n.hardwareConcurrency&&n.hardwareConcurrency<=2)||(n.connection&&n.connection.saveData)||Date.now()-(+ls.getItem('st-lite')||0)<6048e5)))c.add('lite')}catch(e){}})();
  </script>
)}

{isLanding ? (
  <>
    <link rel="stylesheet" href="/assets/css/fonts.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/assets/css/fonts.css"><style>{`.splash{display:none}`}</style></noscript>
  </>
) : (
  <link rel="stylesheet" href="/assets/css/fonts.css" media="print" onload="this.media='all'">
)}
<link rel="stylesheet" href="/assets/css/main.css">
<link rel="stylesheet" href="/assets/css/molecule.css">
{!isLanding && <link rel="stylesheet" href="/assets/css/page.css">}

<!-- scripts start downloading at once (defer: they still run in this order after the page is parsed) -->
<script is:inline src="/assets/vendor/gsap.min.js" defer></script>
<script is:inline src="/assets/vendor/ScrollTrigger.min.js" defer></script>
<script is:inline src="/assets/vendor/lenis.min.js" defer></script>
<script is:inline src="/assets/js/molecule.js" defer></script>
{isLanding && <script is:inline src="/assets/js/forms.js" defer></script>}
<script is:inline src="/assets/js/main.js" defer></script>
<script is:inline src="/assets/js/track.js" async></script>

{isLanding && (
  <>
    <link rel="preload" as="image" href="/assets/img/chain-1800.webp" media="(min-width: 901px) and (min-resolution: 1.5dppx), (min-width: 1301px)" fetchpriority="high">
