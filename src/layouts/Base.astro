---
// src/layouts/Base.astro
// The shared layout for every page. Keep the exact load order from index.html.
interface Props {
  title: string;
  desc?: string;
  canonical?: string;
  ogTitle?: string;
  ogDesc?: string;
  ogUrl?: string;
  isLanding?: boolean;
  is404?: boolean;
  noIndex?: boolean;
  jsonLd?: object | null;
  pageClass?: string;
}

const {
  title,
  desc = '',
  canonical = '',
  ogTitle,
  ogDesc,
  ogUrl,
  isLanding = false,
  is404 = false,
  noIndex = false,
  jsonLd = null,
  pageClass = '',
} = Astro.props;

const site = Astro.site ? Astro.site.href : 'https://stealthtech.agency/';
const siteBase = site.replace(/\/$/, '');
const ogImageAbs = `${siteBase}/assets/og/stealth-tech-og-light.jpg`;
const canonicalAbs = canonical.startsWith('http') ? canonical : `${siteBase}${canonical}`;
const ogUrlAbs = (ogUrl || canonical).startsWith('http') ? (ogUrl || canonical) : `${siteBase}${ogUrl || canonical}`;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
{desc && <meta name="description" content={desc}>}
{noIndex || is404 ? <meta name="robots" content="noindex"> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">}
{is404 && (
  <script is:inline>/* served for any wrong URL (even /a/b/c), so resolve assets from the site root on a real host; file:// keeps relative paths */
if (/^https?:$/.test(location.protocol)) document.write('<base href="/">');</script>
)}
{!is404 && <link rel="canonical" href={canonicalAbs}>}
<meta name="theme-color" content="#F2F3EE">
<meta name="color-scheme" content="dark light">
<meta name="format-detection" content="telephone=no">

<meta property="og:type" content="website">
<meta property="og:site_name" content="Stealth Tech">
<meta property="og:locale" content="en_US">
<meta property="og:title" content={ogTitle || title}>
<meta property="og:description" content={ogDesc || desc}>
<meta property="og:url" content={ogUrlAbs}>
<meta property="og:image" content={ogImageAbs}>
<meta property="og:image:secure_url" content={ogImageAbs}>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Stealth Tech: built for the brands other agencies turn away. A peptide molecule with the Stealth Tech logo.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle || title}>
<meta name="twitter:description" content={ogDesc || desc}>
<meta name="twitter:image" content={ogImageAbs}>
<meta name="twitter:image:alt" content="Stealth Tech: built for the brands other agencies turn away. A peptide molecule with the Stealth Tech logo.">

<link rel="icon" href="/favicon.svg" type="image/svg+xml" id="favicon">
<link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
