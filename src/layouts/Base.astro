<!-- ============ MODAL: discovery brief (6 steps) + Cal.id calendar ============ -->
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="mTitle" hidden>
 <div class="modal-bg" data-close></div>
 <div class="modal-card" data-lenis-prevent>
  <button class="modal-x" type="button" data-close aria-label="Close"><svg><use href="#i-close"/></svg></button>
  <p class="m-kicker">Free 30-minute strategy call</p>
  <div class="m-prog"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <form class="m-form" id="mForm" name="discovery" novalidate>
   <p class="m-hp" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
   <fieldset class="m-step is-on" data-step="0">
    <legend id="mTitle" class="m-h">What are you building?</legend>
    <div class="m-chips">
     <label><input type="radio" name="cat" value="Peptide / RUO brand" checked><span>Peptide / RUO brand</span></label>
     <label><input type="radio" name="cat" value="Hemp or botanical"><span>Hemp or botanical</span></label>
     <label><input type="radio" name="cat" value="Kanna"><span>Kanna</span></label>
     <label><input type="radio" name="cat" value="Clinic or telehealth"><span>Clinic or telehealth</span></label>
     <label><input type="radio" name="cat" value="Something else"><span>Something else</span></label>
    </div>
   </fieldset>
   <fieldset class="m-step" data-step="1">
    <legend class="m-h">Where is your brand today?</legend>
    <div class="m-chips m-chips--col">
     <label><input type="radio" name="stage" value="Planning" checked><span>Planning<small>Idea, product or supplier lined up, nothing built yet</small></span></label>
     <label><input type="radio" name="stage" value="Already in work"><span>Already in work<small>Brand or store is being built</small></span></label>
     <label><input type="radio" name="stage" value="Advanced stages"><span>Advanced stages<small>Almost ready, a few things are blocking launch</small></span></label>
     <label><input type="radio" name="stage" value="Launched"><span>Launched<small>Live and selling, ready to fix or grow</small></span></label>
    </div>
    <p class="m-sub">Where are you stuck?</p>
    <div class="m-chips">
     <label><input type="radio" name="stuck" value="Starting from zero" checked><span>Starting from zero</span></label>
     <label><input type="radio" name="stuck" value="Store looks untrustworthy"><span>Store looks untrustworthy</span></label>
     <label><input type="radio" name="stuck" value="Processor or payout issues"><span>Processor or payout issues</span></label>
     <label><input type="radio" name="stuck" value="Platform shut my store down"><span>Platform shut my store down</span></label>
     <label><input type="radio" name="stuck" value="Ready to add marketing"><span>Ready to add marketing</span></label>
    </div>
   </fieldset>
   <fieldset class="m-step" data-step="2">
    <legend class="m-h">What do you need help with?</legend>
    <p class="m-note" id="helpNote">Pick everything that applies.</p>
    <div class="m-chips m-chips--multi">
     <label><input type="checkbox" name="help" value="Website build"><span>Website build<small>Store or site</small></span></label>
     <label><input type="checkbox" name="help" value="Mobile app"><span>Mobile app<small>iOS and Android</small></span></label>
     <label><input type="checkbox" name="help" value="Feature integration"><span>Feature integration<small>Wholesale, affiliates, subscriptions, portals</small></span></label>
     <label><input type="checkbox" name="help" value="Design / UI-UX"><span>Design / UI-UX<small>Brand, labels, interfaces</small></span></label>
     <label><input type="checkbox" name="help" value="Checkout &amp; payments"><span>Checkout &amp; payments<small>Processor-ready checkout</small></span></label>
     <label><input type="checkbox" name="help" value="Marketing"><span>Marketing<small>SEO, email, SMS, paid social</small></span></label>
     <label><input type="checkbox" name="help" value="Compliance: HIPAA"><span>Compliance: HIPAA<small>Clinics and telehealth</small></span></label>
     <label><input type="checkbox" name="help" value="Compliance: LegitScript"><span>Compliance: LegitScript<small>Certification readiness</small></span></label>
    </div>
   </fieldset>
   <fieldset class="m-step" data-step="3">
    <legend class="m-h">Budget and location</legend>
    <div class="m-fields m-grid">
     <label><span>Minimum budget (USD)</span><input name="budget_min" data-money inputmode="numeric" autocomplete="off" placeholder="Type an amount" required></label>
     <label><span>Maximum budget (USD)</span><input name="budget_max" data-money inputmode="numeric" autocomplete="off" placeholder="Type an amount" required></label>
     <label><span>Country</span><input name="country" data-suggest="stCountries" autocomplete="off" placeholder="Start typing" required></label>
     <label><span>State / region</span><input name="region" data-suggest="stRegions" autocomplete="off" placeholder="Optional"></label>
     <label class="m-wide"><span>When do you want to launch?</span><select name="timeline"><option>As soon as possible</option><option selected>In 1 to 3 months</option><option>In 3 to 6 months</option><option>Just exploring</option></select></label>
    </div>
    <p class="m-err" id="budgetErr" hidden>The maximum budget needs to be at least the minimum.</p>
    <datalist id="stCountries"><option value="United States"></option><option value="Canada"></option><option value="United Kingdom"></option><option value="Australia"></option><option value="India"></option><option value="Germany"></option><option value="Netherlands"></option><option value="United Arab Emirates"></option><option value="Afghanistan"></option><option value="Albania"></option><option value="Algeria"></option><option value="Argentina"></option><option value="Armenia"></option><option value="Austria"></option><option value="Azerbaijan"></option><option value="Bahamas"></option><option value="Bahrain"></option><option value="Bangladesh"></option><option value="Belgium"></option><option value="Bolivia"></option><option value="Brazil"></option><option value="Bulgaria"></option><option value="Chile"></option><option value="China"></option><option value="Colombia"></option><option value="Croatia"></option><option value="Cyprus"></option><option value="Czechia"></option><option value="Denmark"></option><option value="Egypt"></option><option value="Estonia"></option><option value="Ethiopia"></option><option value="Finland"></option><option value="France"></option><option value="Georgia"></option><option value="Ghana"></option><option value="Greece"></option><option value="Guatemala"></option><option value="Hungary"></option><option value="Iceland"></option><option value="Indonesia"></option><option value="Iran"></option><option value="Iraq"></option><option value="Ireland"></option><option value="Israel"></option><option value="Italy"></option><option value="Jamaica"></option><option value="Japan"></option><option value="Jordan"></option><option value="Kazakhstan"></option><option value="Kenya"></option><option value="Kuwait"></option><option value="Latvia"></option><option value="Lebanon"></option><option value="Lithuania"></option><option value="Luxembourg"></option><option value="Malaysia"></option><option value="Malta"></option><option value="Mexico"></option><option value="Moldova"></option><option value="Morocco"></option><option value="Mozambique"></option><option value="Nepal"></option><option value="New Zealand"></option><option value="Nigeria"></option><option value="Norway"></option><option value="Oman"></option><option value="Pakistan"></option><option value="Panama"></option><option value="Peru"></option><option value="Philippines"></option><option value="Poland"></option><option value="Portugal"></option><option value="Qatar"></option><option value="Romania"></option><option value="Russia"></option><option value="Rwanda"></option><option value="Saudi Arabia"></option><option value="Senegal"></option><option value="Serbia"></option><option value="Singapore"></option><option value="Slovakia"></option><option value="Slovenia"></option><option value="South Africa"></option><option value="South Korea"></option><option value="Spain"></option><option value="Sri Lanka"></option><option value="Sweden"></option><option value="Switzerland"></option><option value="Taiwan"></option><option value="Tanzania"></option><option value="Thailand"></option><option value="Turkey"></option><option value="Ukraine"></option><option value="Uruguay"></option><option value="Uzbekistan"></option><option value="Venezuela"></option><option value="Vietnam"></option><option value="Yemen"></option><option value="Zambia"></option><option value="Zimbabwe"></option></datalist>
   </fieldset>
   <fieldset class="m-step" data-step="4">
    <legend class="m-h">Where should we send your plan?</legend>
    <div class="m-fields m-grid">
     <label><span>Name</span><input name="name" autocomplete="name" required></label>
     <label><span>Work email</span><input name="email" type="email" autocomplete="email" inputmode="email" required></label>
     <label><span>Phone or WhatsApp (optional)</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel"></label>
     <label><span>Website (optional)</span><input name="site" autocomplete="url" placeholder="your-store.com"></label>
     <label class="m-wide"><span>Anything we should know? (optional)</span><textarea name="notes" rows="3" maxlength="1200" placeholder="Products, platform, what has been tried so far"></textarea></label>
    </div>
    <p class="m-note">We reply within one business day. No spam, no sharing.</p>
   </fieldset>
   <div class="m-step m-cal" data-step="5">
    <p class="m-h">Thanks. Now pick a time for your call.</p>
    <div class="m-cal-box" id="calBox"><p class="m-cal-ph">Loading calendar…</p></div>
    <p class="m-cal-alt">Calendar not loading? <a id="calLink" href="https://cal.id/arpitsharmawritingsessions/peptide-brand-discovery-call" target="_blank" rel="noopener">Open it in a new tab</a>.</p>
   </div>
   <div class="m-foot">
    <button type="button" class="m-back" data-back>Back</button>
    <button type="submit" class="btn btn--sm m-next"><span class="btn-t">Continue</span><span class="btn-i" aria-hidden="true"><svg><use href="#i-arrow"/></svg></span></button>
   </div>
  </form>
 </div>
</div>

