    <link rel="preload" as="image" href="/assets/img/chain-760.webp" media="(max-width: 600px)" fetchpriority="high">
  </>
)}

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

