---
// src/pages/404.astro
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found | Stealth Tech"
  is404={true}
  noIndex={true}
>
  <style slot="head">
  .nf{position:relative;z-index:2;min-height:100vh;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:88px 20px 28px}
  .nf-code{position:relative;z-index:0;font-weight:300;font-size:clamp(96px,min(14vw,22vh),200px);line-height:.86;letter-spacing:-.065em;margin:0;padding-right:.06em;color:var(--ink);background:linear-gradient(180deg,var(--ink) 22%,var(--acc) 118%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .nf-code::after{content:"";position:absolute;left:50%;top:58%;width:70%;height:60%;transform:translate(-50%,-50%);background:radial-gradient(closest-side,var(--glow2),transparent);z-index:-1;pointer-events:none}
  .mol-stage--404{width:100%;z-index:1;margin-top:-1vh}
  .nf h1{position:relative;z-index:2;font-weight:300;font-size:clamp(28px,min(3.8vw,6vh),50px);letter-spacing:-.045em;line-height:1.08;margin:1.5vh 0 10px}
  .nf-p{position:relative;z-index:2;color:var(--mut);max-width:42ch;margin:0 auto}
  .nf .ip-act{justify-content:center;position:relative;z-index:2;margin-top:22px}
  .nf-hint{position:relative;z-index:2;display:inline-flex;align-items:center;gap:10px;margin-top:18px;font-size:12px;letter-spacing:.04em;color:var(--mut)}
  .nf-hint .t{display:none}
  @media (hover:none){.nf-hint .d{display:none}.nf-hint .t{display:inline}}
  .nf-foot{position:relative;z-index:2;padding:0 20px 28px;text-align:center;font-size:12px;color:var(--mut)}
  @media (max-width:700px){.nf{padding-top:80px}.nf-code{font-size:30vw}.nf h1{margin-top:1vh}.nf .ip-act{margin-top:18px}.nf .ip-act .btn{width:auto}}
  </style>

  <!-- ============ TOP BAR ============ -->
  <header class="top" id="top">
   <a class="brand" href="/" aria-label="Stealth Tech home">
    <svg class="brand-mark" aria-hidden="true"><use href="#logo"/></svg>
    <span class="brand-word">Stealth Tech</span>
   </a>
   <div class="top-r">
    <button class="theme-t" type="button" data-theme-toggle aria-label="Switch to dark theme">
     <svg class="ico-sun" aria-hidden="true"><use href="#i-sun"/></svg><svg class="ico-moon" aria-hidden="true"><use href="#i-moon"/></svg>
    </button>
    <a class="btn btn--sm" href="#book" data-book data-pulse><span class="btn-t">Book a call</span><span class="btn-i" aria-hidden="true"><svg><use href="#i-arrow"/></svg></span></a>
   </div>
  </header>

  <main class="nf" id="main">
   <p class="nf-code" aria-hidden="true">404</p>
   <div class="mol-stage mol-stage--404" id="mol404" data-mol="404">
    <canvas class="mol-gl" role="img" aria-label="The Stealth Tech molecule"></canvas>
    <img class="mol-still" data-src="/assets/img/chain-1100.webp" data-srcset="/assets/img/chain-760.webp 760w, /assets/img/chain-1100.webp 1100w, /assets/img/chain-1800.webp 1800w" sizes="(max-width: 900px) 94vw, 900px" alt="" width="1100" height="349" decoding="async" draggable="false">
    <noscript><img class="mol-noscript" src="/assets/img/chain-1100.webp" alt="" width="1100" height="349" loading="lazy"></noscript>
   </div>
   <h1>This page went stealth.</h1>
   <p class="nf-p">The link may be old, or the page moved quietly. Everything else is exactly where you left it.</p>
   <div class="ip-act"><a class="btn" href="/"><span class="btn-t">Back to home</span><span class="btn-i" aria-hidden="true"><svg><use href="#i-arrow"/></svg></span></a><a class="btn2" href="/#services"><span data-brick>See our services</span></a></div>
   <p class="nf-hint"><svg class="mol-i" aria-hidden="true"><use href="#mol"/></svg><span class="d">Click to stretch it. Drag to pull it.</span><span class="t">Tap to stretch it. Drag to pull it.</span></p>
  </main>
  <footer class="nf-foot">© 2026 Stealth Tech. The quiet growth partner for research-led brands.</footer>
</Base>
