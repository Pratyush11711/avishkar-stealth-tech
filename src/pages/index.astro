   </div>
   <div class="marquee" aria-label="Client logos">
    <div class="marquee-track">
     <span class="logo-it"><img src="/assets/logos/frontier-biomed.webp" alt="Frontier Biomed" height="30" decoding="async" fetchpriority="low"></span>
