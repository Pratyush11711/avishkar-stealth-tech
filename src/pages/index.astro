<!-- ============ TOP BAR ============ -->
<header class="top" id="top">
 <a class="brand" href="#main" aria-label="Stealth Tech home">
  <svg class="brand-mark" aria-hidden="true"><use href="#logo"/></svg>
  <span class="brand-word">Stealth Tech</span>
 </a>
 <div class="top-r">
  <button class="theme-t" type="button" data-theme-toggle aria-label="Switch to dark theme">
   <svg class="ico-sun" aria-hidden="true"><use href="#i-sun"/></svg><svg class="ico-moon" aria-hidden="true"><use href="#i-moon"/></svg>
  </button>
  <a class="btn btn--sm" href="#book" data-book data-pulse><span class="btn-t">Book a call</span><span class="btn-i" aria-hidden="true"><svg><use href="#i-arrow"/></svg></span></a>
 </div>
</header>

<main id="main">

<!-- ============ HERO ============ -->
<section class="hero" id="hero" aria-labelledby="heroTitle">
 <div class="hero-head">
  <h1 class="hero-h" id="heroTitle">
   <span class="eyebrow hero-eb hero-rv"><svg class="mol-i" aria-hidden="true"><use href="#mol"/></svg><span data-scramble>Peptide brand design and development studio</span></span>
   <span class="hl"><span class="hl-i">The quiet<span class="hero-nl"></span> force behind</span></span>
   <span class="hl"><span class="hl-i"><span class="acc-w">peptide</span> brands.</span></span>
  </h1>
 </div>

 <!-- the molecule: the chain picture brought to life by assets/js/molecule.js (WebGL); the plain picture is the fallback -->
 <div class="mol-stage mol-stage--hero" id="molStage" data-mol="hero">
  <canvas class="mol-gl" role="img" aria-label="A peptide chain with the Stealth Tech logo at its centre"></canvas>
  <img class="mol-still" data-src="/assets/img/chain-1100.webp" data-srcset="/assets/img/chain-760.webp 760w, /assets/img/chain-1100.webp 1100w, /assets/img/chain-1800.webp 1800w" sizes="(max-width: 900px) 96vw, 80vw" alt="" width="1100" height="349" decoding="async" draggable="false">
  <noscript><img class="mol-noscript" src="/assets/img/chain-1100.webp" alt="" width="1100" height="349" loading="lazy"></noscript>
 </div>

 <div class="hero-foot">
  <div class="hero-r hero-rv">
   <p class="hero-sub">Brands that look legit. Stores that stay live. Checkouts that get approved.</p>
   <div class="hero-cta">
    <a class="btn" href="#book" data-book data-pulse><span class="btn-t">Book a free strategy call</span><span class="btn-i" aria-hidden="true"><svg><use href="#i-arrow"/></svg></span></a>
