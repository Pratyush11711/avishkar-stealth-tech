    <div class="ind-c ind-c2"><img src="/assets/img/ind-kanna-1672.webp" srcset="/assets/img/ind-kanna-900.webp 900w, /assets/img/ind-kanna-1280.webp 1280w, /assets/img/ind-kanna-1672.webp 1672w" sizes="100vw" alt="" width="1672" height="941" loading="lazy" decoding="async"></div>
