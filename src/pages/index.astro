---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import { FAQ_ITEMS } from '../data/faq';

const site = 'https://stealthtech.agency';
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${site}/#org`,
      "name": "Stealth Tech",
      "url": `${site}/`,
      "logo": `${site}/assets/icons/icon-512.png`,
      "image": `${site}/assets/og/stealth-tech-og-light.jpg`,
      "description": "Design and development partner for peptide, RUO, hemp, botanical and kanna brands: brand identity, compliance-focused websites and stores, processor-ready checkout and back office systems, with SEO, email and paid social as add-ons.",
      "slogan": "The quiet force behind peptide brands.",
      "areaServed": "Worldwide",
      "priceRange": "$$$",
      "email": "wassamrehman@gmail.com",
      "knowsAbout": [
        "Peptide website design","Peptide brand design","WooCommerce development for RUO brands","Vial label design","Peptide marketing","RUO peptide marketing","Research peptide ecommerce","Peptide SEO","High-risk payment processing","Compliance-focused copywriting","Meta and TikTok ads for regulated products","Hemp marketing","Botanical extract marketing","Kanna marketing","Telehealth marketing","Email and SMS retention"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Services",
        "itemListElement": [
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"Brand identity and launch for peptide and RUO brands"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"Compliance-focused websites and stores"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"Processor-ready checkout and high-risk payment guidance"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"Back office: wholesale, affiliates, subscriptions, portals"}},
          {"@type":"Offer","itemOffered":{"@type":"Service","name":"Marketing add-ons: SEO, email, SMS and paid social"}}
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#site`,
      "url": `${site}/`,
      "name": "Stealth Tech",
      "inLanguage": "en",
      "publisher": {"@id": `${site}/#org`}
    },
    {
      "@type": "WebPage",
      "@id": `${site}/#page`,
      "url": `${site}/`,
      "name": "Peptide Brand Design and Development | Stealth Tech",
      "description": "Peptide brand design and development for RUO, hemp and kanna brands: compliant websites, processor-ready checkout and marketing add-ons.",
      "isPartOf": {"@id": `${site}/#site`},
      "about": {"@id": `${site}/#org`},
      "primaryImageOfPage": `${site}/assets/og/stealth-tech-og-light.jpg`
    },
    {
      "@type": "FAQPage",
      "mainEntity": FAQ_ITEMS.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---
<Base
  title="Peptide Brand Design and Development | Stealth Tech"
  desc="Peptide brand design and development for RUO, hemp and kanna brands: compliant websites, processor-ready checkout and marketing add-ons. Book a free strategy call."
  canonical="/"
  ogTitle="Peptide Brand Design and Development | Stealth Tech"
  ogDesc="Brands that look legit, stores that stay live and checkouts that get approved. One senior team for peptide and RUO brands."
  isLanding={true}
  jsonLd={jsonLd}
>

